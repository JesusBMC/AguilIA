# AgilIA MVP — environment configuration
# Copy this file to `.env` and adjust as needed. The LOCAL provider needs
# NONE of the AWS_* values below — they are only read when AIDLC_PROVIDER=aws.

# Provider selector: "local" (default, fully offline) or "aws" (thin SDK wiring).
AIDLC_PROVIDER=local

# Local HTTP server port (default 8787 when unset or invalid).
PORT=8787

# -----------------------------------------------------------------------------
# AWS placeholders — ONLY used when AIDLC_PROVIDER=aws. The local provider
# ignores all of these; leave them blank for offline development.
# Never commit real credentials. Use your AWS credential chain / a secrets
# manager for runtime secrets — these are non-secret resource identifiers only.
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_DYNAMODB_DOCUMENTS_TABLE=
AWS_DYNAMODB_DECISIONS_TABLE=
AWS_DYNAMODB_VERSIONS_TABLE=
AWS_OPENSEARCH_ENDPOINT=
