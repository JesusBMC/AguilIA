# AgilIA MVP - environment configuration
# Copy this file to `.env` and adjust as needed. The LOCAL provider needs
# NONE of the AWS_* / AGILIA_* values below - they are only read when
# AIDLC_PROVIDER=aws (on AWS, Terraform sets them on the Lambdas).

# Provider selector: "local" (default, fully offline) or "aws" (thin SDK wiring).
AIDLC_PROVIDER=local

# Local HTTP server port (default 8787 when unset or invalid).
PORT=8787

# -----------------------------------------------------------------------------
# AWS settings - ONLY used when AIDLC_PROVIDER=aws. The local provider
# ignores all of these; leave them blank for offline development.
# Never commit real credentials. Use your AWS credential chain / a secrets
# manager for runtime secrets - these are non-secret resource identifiers only.
# -----------------------------------------------------------------------------

# Region (Terraform deploys to us-east-2). Lambda sets AWS_REGION itself.
AWS_REGION=us-east-2

# S3 documents bucket (Terraform output: documents_bucket_name).
AWS_S3_BUCKET=

# DynamoDB tables (defaults match the Terraform names for env "dev").
AWS_DYNAMODB_TRACEABILITY_TABLE=agilia-traceability-dev
AWS_DYNAMODB_FINDINGS_TABLE=agilia-findings-dev

# Legacy table selectors (kept for compatibility; the traceability table
# above is the one used by the single-table design).
AWS_DYNAMODB_DOCUMENTS_TABLE=
AWS_DYNAMODB_DECISIONS_TABLE=
AWS_DYNAMODB_VERSIONS_TABLE=

# Bedrock model ids: Claude Haiku 4.5 through the US inference profile.
# Confirmar acceso en la cuenta (formulario de Anthropic + primera invocación).
AWS_BEDROCK_RULE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEDROCK_DRAFT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Comprehend language code.
AWS_COMPREHEND_LANGUAGE=es

# Search backend: "dynamodb" (default, scans the findings table) or
# "opensearch" (requires AWS_OPENSEARCH_ENDPOINT, requests are SigV4-signed).
AWS_SEARCH_BACKEND=dynamodb
AWS_OPENSEARCH_ENDPOINT=

# Async upload wiring used by the API/worker Lambdas
# (Terraform outputs: processing_queue_url, event_bus_name).
AGILIA_QUEUE_URL=
AGILIA_EVENT_BUS_NAME=
